PORT=3000
# Server-only Supabase credentials; NEVER expose these in browser/mobile code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Used only when Supabase is not configured and the host provides a durable mounted disk.
DREAM_WIFI_SOURCE_TOKEN=
DREAM_WIFI_DATA_DIR=./data
DREAM_WIFI_STORAGE_READY=false
# Authorized source-side device only:
# Authorized source-side device only:
DREAM_WIFI_TUNNEL_URL=wss://YOUR_DEPLOYED_HOST/api/dream-wifi/tunnel
DREAM_WIFI_SOURCE_NAME=
DREAM_WIFI_SOURCE_ID=
DREAM_WIFI_SOURCE_LATITUDE=
DREAM_WIFI_SOURCE_LONGITUDE=
# Remote SOCKS client only:
DREAM_WIFI_PROXY_PORT=1080
DREAM_WIFI_SELECTED_SOURCE_ID=
